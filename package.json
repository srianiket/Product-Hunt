{
  "name": "product-hunt-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Spare QA take-home: Product Hunt UI + GraphQL API automation (Bun, Playwright, TypeScript)",
  "type": "module",
  "scripts": {
    "test": "bun run test:api && bun run test:e2e",
    "test:api": "bun test ./tests/api",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
